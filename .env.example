# ==============================================================================
# BusinessOS AI — Environment Configuration Template
# Copy this file to .env and adjust variables to match your environment.
# DO NOT commit the actual .env file with secrets to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=businessos
POSTGRES_PASSWORD=businessos_pass
POSTGRES_DB=businessos_db
DATABASE_URL=postgresql+asyncpg://businessos:businessos_pass@localhost:5432/businessos_db

# ------------------------------------------------------------------------------
# Backend & Security
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000"]

# ------------------------------------------------------------------------------
# AI & Large Language Models
# ------------------------------------------------------------------------------
# Options: "gemini" or "openai"
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# Embeddings & RAG Vector Store
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_PATH=./data/faiss_index

# ------------------------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api
