# ==============================================================================
# BusinessOS AI — Root .gitignore
# Prevents sensitive credentials, environments, build artifacts, and caches from being tracked
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL - DO NOT COMMIT SECRETS)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
secrets/
*.pem
*.key
*.cert
*.crt
credentials.json
client_secret*.json

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
develop-eggs/
/dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
backend/venv/
backend/.venv/
env.bak/
venv.bak/

# Python Testing & Type Checking
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------------------------
# Node.js, Frontend & Build Artifacts
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
frontend/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.pnpm-store/

# Next.js Build Output & Cache
.next/
*/.next/
frontend/.next/
/out/
frontend/out/

# Next.js / Turbo / Vercel
.turbo/
.turbopack/
.vercel/
*.tsbuildinfo

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
logs/

# ------------------------------------------------------------------------------
# Database, Local Storage & AI Artifacts
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
postgres_data/
docker/data/
data/
backend/data/
faiss_index/
*.faiss
*.pkl

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# AI Agent & Workspace Scratch
# ------------------------------------------------------------------------------
.gemini/
.claude/
scratch/
