# ==============================================================================
# BusinessOS AI — Backend .gitignore
# ==============================================================================

# Environment files
.env
.env.*
!.env.example
*.env

# Python Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
.venv/
env/
ENV/

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Data & AI Models / Embeddings / FAISS
data/
*.faiss
*.pkl
*.sqlite
*.sqlite3
*.db
